{
  "name": "esquadrao-fc",
  "private": true,
  "version": "1.5.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validar-dados": "tsx scripts/validar-dados.ts",
    "calibrar": "tsx scripts/calibrar.ts",
    "apk": "node scripts/apk.mjs",
    "android": "npm run build && npx cap sync android && npx cap open android",
    "fotos": "tsx scripts/buscar-fotos.ts",
    "playtest": "node scripts/playtest.mjs",
    "formatar-dados": "tsx scripts/formatar-dados.ts",
    "checar": "npm run typecheck && npm test && npm run validar-dados"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/saira": "^5.3.0",
    "@fontsource/saira-extra-condensed": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "fake-indexeddb": "^6.2.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
